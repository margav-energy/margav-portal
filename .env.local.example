# Copy this file to .env.local and fill in your Supabase project's values.
# Supabase dashboard → Project Settings → API.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "public" key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" key — server-only, never exposed to the browser.
# Required for the public "/survey/[token]" pre-installation survey form and
# "/sign/[token]" e-signature form (see src/lib/supabase/service.ts) —
# surveyors/customers open these with no portal login, so there's no
# authenticated session for a normal client to use. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=

# Powers the "Presenter" sales-deck upload (Settings → Presenter Deck,
# admin-only) — converts an uploaded .pptx to per-slide PNGs.
# Sign up at https://cloudconvert.com, then create a key under
# Dashboard → API Keys. Not required unless you're using that feature.
CLOUDCONVERT_API_KEY=

# Resend — powers the "Communications" button AND "Send Quote"'s e-signature
# link email on a quote's detail page (src/lib/resend.ts,
# src/components/quotes/actions.ts → sendCommunicationEmail/sendQuote).
# Sign up at https://resend.com, verify the margav.energy sending domain
# under Domains, then create a key under API Keys. Not required unless
# you're sending from those, which show a clear setup error instead of
# crashing if this is missing. Every email sends from lucy@margav.energy
# (see EMAIL_FROM in src/lib/resend.ts) regardless of who's logged in.
#
# Note: e-signature itself (the "Send Quote" → /sign/[token] flow) is
# self-hosted — see src/data/signature-service.ts and
# supabase/migrations/0010_self_signed_documents.sql — no third-party
# e-signature provider or API key is used anymore (Dropbox Sign removed).
RESEND_API_KEY=

# Google Maps Platform — powers two features, both server-only (never sent
# to the browser), and both fall back gracefully (manual address entry /
# manual photo upload) if this isn't set:
#   - Address autocomplete on the "Find address" button on Create
#     Appointment (src/lib/address-lookup.ts) — replaces the earlier
#     getAddress.io integration.
#   - Auto-fetching a Street View photo of the property for a quote's
#     Property Photo card (src/lib/google-street-view.ts), so reps don't
#     have to take/upload one themselves.
#
# Requires a Google Cloud project with billing enabled and, under APIs &
# Services → Library, both "Places API" and "Street View Static API"
# enabled. Then create a key under APIs & Services → Credentials — one key
# covers both APIs, as long as its API restrictions (if any) allow both.
GOOGLE_MAPS_API_KEY=

# Google Calendar — when an appointment is created (Create Appointment form,
# src/components/appointments/actions.ts → createAppointmentAction), this
# adds a matching event to Lucy's Google Calendar with the customer's name,
# address, phone, email, product and notes in the description, so she can
# see it at a glance without opening the portal (src/lib/google-calendar.ts).
# Not required — the app falls back to just not creating the event if unset.
#
# This authenticates as Lucy herself via a standard OAuth2 refresh token —
# NOT a service account. (A service-account-key approach was tried first,
# but this Google Cloud org enforces the
# "iam.disableServiceAccountKeyCreation" policy, which blocks downloadable
# service-account keys entirely — ask your org's GCP Organization Policy
# Administrator to override it for this project if you'd rather use that
# approach instead; it wasn't available when this was set up.)
#
# One-time setup:
#   1. Google Cloud Console → APIs & Services → Library → enable the
#      "Google Calendar API".
#   2. APIs & Services → OAuth consent screen → User type: "Internal"
#      (this requires the project to be under your Google Workspace org —
#      Internal means no Google verification review and no 7-day token
#      expiry, since only people in your Workspace can ever consent).
#      Add scope https://www.googleapis.com/auth/calendar.events.
#   3. APIs & Services → Credentials → Create Credentials → OAuth client ID
#      → Application type "Web application" → under "Authorized redirect
#      URIs" add: https://developers.google.com/oauthplayground
#      This gives you a Client ID and Client Secret — that's
#      GOOGLE_CALENDAR_CLIENT_ID / GOOGLE_CALENDAR_CLIENT_SECRET below.
#   4. Go to https://developers.google.com/oauthplayground → click the ⚙️
#      gear icon (top right) → check "Use your own OAuth credentials" →
#      paste the Client ID + Client Secret from step 3.
#   5. In the left panel, find "Calendar API v3" (or paste
#      https://www.googleapis.com/auth/calendar.events directly into the
#      "Input your own scopes" box) → check it → click "Authorize APIs".
#   6. Sign in as LUCY (must be her Google account, logged in in that
#      browser) and grant access.
#   7. Back on the Playground, click "Exchange authorization code for
#      tokens" → copy the "Refresh token" value shown — that's
#      GOOGLE_CALENDAR_REFRESH_TOKEN below. (The access token shown at the
#      same time is short-lived and NOT needed — the app fetches its own
#      from the refresh token at runtime.)
#
# The refresh token doesn't expire on its own (Internal apps aren't subject
# to the 7-day unverified-app expiry) — it only stops working if Lucy
# revokes access at myaccount.google.com/permissions or changes her
# password.

# From the OAuth client created in step 3.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# From step 7 above — issued to Lucy's account specifically.
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Which of her calendars to write to — almost always leave unset, which
# defaults to "primary" (her main calendar). Only set this to a specific
# calendar ID if events should land on a secondary calendar instead.
GOOGLE_CALENDAR_ID=
