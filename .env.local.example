# Copy this file to .env.local and fill in your Supabase project's values.
# Supabase dashboard → Project Settings → API.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "public" key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" key — server-only, never exposed to the browser.
# Required for the public "/survey/[token]" pre-installation survey form and
# "/sign/[token]" e-signature form (see src/lib/supabase/service.ts) —
# surveyors/customers open these with no portal login, so there's no
# authenticated session for a normal client to use. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=

# Powers the "Presenter" sales-deck upload (Settings → Presenter Deck,
# admin-only) — converts an uploaded .pptx to per-slide PNGs.
# Sign up at https://cloudconvert.com, then create a key under
# Dashboard → API Keys. Not required unless you're using that feature.
CLOUDCONVERT_API_KEY=

# Resend — powers the "Communications" button AND "Send Quote"'s e-signature
# link email on a quote's detail page (src/lib/resend.ts,
# src/components/quotes/actions.ts → sendCommunicationEmail/sendQuote).
# Sign up at https://resend.com, verify the margav.energy sending domain
# under Domains, then create a key under API Keys. Not required unless
# you're sending from those, which show a clear setup error instead of
# crashing if this is missing. Every email sends from lucy@margav.energy
# (see EMAIL_FROM in src/lib/resend.ts) regardless of who's logged in.
#
# Note: e-signature itself (the "Send Quote" → /sign/[token] flow) is
# self-hosted — see src/data/signature-service.ts and
# supabase/migrations/0010_self_signed_documents.sql — no third-party
# e-signature provider or API key is used anymore (Dropbox Sign removed).
RESEND_API_KEY=

# getAddress.io — powers the "Find address" button on Create Appointment
# (src/lib/address-lookup.ts). Sign up at https://getaddress.io, then copy
# your API key from the dashboard. Server-only — never sent to the browser.
# Not required unless you're using that button — without it, the form
# falls back to manual address entry (same as before this was wired up).
GETADDRESS_API_KEY=

# Google Maps Platform — auto-fetches a Street View photo of the property
# for a quote's Property Photo card (src/lib/google-street-view.ts) so reps
# don't have to take/upload one themselves. Requires a Google Cloud project
# with billing enabled and the "Street View Static API" enabled under
# APIs & Services → Library, then a key created under APIs & Services →
# Credentials (restrict it to that API). Server-only — never sent to the
# browser. Not required unless you're using that feature — without it,
# the card falls back to manual upload only (same as before this was wired
# up).
GOOGLE_MAPS_API_KEY=
