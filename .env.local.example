# Copy this file to .env.local and fill in your Supabase project's values.
# Supabase dashboard → Project Settings → API.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "public" key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" key — server-only, never exposed to the browser.
# Required for the public "/survey/[token]" pre-installation survey form
# (see src/lib/supabase/service.ts) — surveyors fill it in with no portal
# login, so it can't use a normal authenticated session. Also used by the
# Dropbox Sign webhook below, for the same reason. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=

# Powers the "Presenter" sales-deck upload (Settings → Presenter Deck,
# admin-only) — converts an uploaded .pptx to per-slide PNGs.
# Sign up at https://cloudconvert.com, then create a key under
# Dashboard → API Keys. Not required unless you're using that feature.
CLOUDCONVERT_API_KEY=

# Dropbox Sign e-signature — powers the "Send Quote" button
# (src/lib/dropbox-sign.ts) and the /api/dropbox-sign/webhook route that
# flips a quote to "Signed" once the customer finishes signing. Sign up at
# https://app.hellosign.com, then Settings → API for a key. Not required
# unless you're using e-signature sending — sendQuote() shows a clear setup
# error instead of crashing if this is missing. Also used to verify that
# inbound webhook callbacks really came from Dropbox Sign — keep it secret.
DROPBOX_SIGN_API_KEY=

# The Dropbox Sign Template ID used for every quote sent for signature (one
# shared template for both boiler and solar quotes). Build it in the
# Dropbox Sign dashboard → Templates with a signer role named exactly
# "Client" and custom fields named: customer_name, customer_address,
# quote_reference, product_type, total_price, payment_method,
# key_line_items, sent_date — then copy its ID here (Templates → your
# template → Details).
DROPBOX_SIGN_TEMPLATE_ID=

# Set to "false" once ready to send real (non-test) signature requests.
# Defaults to test mode so nothing here can accidentally go live before
# you're ready — test-mode requests don't count against quota.
DROPBOX_SIGN_TEST_MODE=true

# Resend — powers the "Communications" button on a quote's detail page
# (src/lib/resend.ts, src/components/quotes/actions.ts → sendCommunicationEmail).
# Sign up at https://resend.com, verify the margav.energy sending domain
# under Domains, then create a key under API Keys. Not required unless
# you're sending from that button — it shows a clear setup error instead of
# crashing if this is missing. Every email sends from lucy@margav.energy
# (see EMAIL_FROM in src/lib/resend.ts) regardless of who's logged in.
RESEND_API_KEY=
